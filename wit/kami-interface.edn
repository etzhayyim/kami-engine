[{:db/id -1, :wit.kami-interface/package "kami:engine@1.0.0", :wit.kami-interface/world "kami-game", :wit.kami-interface/interfaces "{:aim {:doc \"controller pose and the camera-relative movement basis\", :funcs {:look-at {:params [[:entity :eid] [:target :eid]], :doc \"Face `target`, applying the scene's configured aim error. Keeps bots and players on one aiming path, so a bot cannot be more accurate than the weapon it holds allows.\"}, :add-look {:params [[:entity :eid] [:dyaw :f32] [:dpitch :f32]], :doc \"Fold a mouse / stick look delta into the pose.\"}, :move-to {:params [[:entity :eid] [:x :f32] [:y :f32] [:z :f32] [:speed :f32]], :doc \"Set ground velocity toward a world point at `speed`. Like move-toward but to a position rather than an entity, so a guest can walk to a zone centre read from the zone interface without doing arithmetic on it.\"}, :yaw {:params [[:entity :eid]], :ret :f32, :doc \"Facing around +Y in radians (f32 bits), wrapped to (-pi, pi].\"}, :move {:params [[:entity :eid] [:strafe :f32] [:forward :f32] [:speed :f32]], :doc \"Set ground velocity from CAMERA-relative stick input; diagonals are not faster.\"}, :pitch {:params [[:entity :eid]], :ret :f32, :doc \"Look elevation in radians (f32 bits), clamped by the camera rig.\"}, :ads {:params [[:entity :eid]], :ret :f32, :doc \"Current aim-down-sight blend.\"}, :set-ads-held {:params [[:entity :eid] [:held :i32]], :doc \"Drive the aim-down-sight blend toward held/released at the scene's blend rate. The guest cannot interpolate a float itself, and a guest that could would snap the camera instead of blending it.\"}, :set-ads {:params [[:entity :eid] [:blend :f32]], :doc \"Set the aim-down-sight blend in [0,1]; tightens spread and narrows FOV.\"}, :set-look {:params [[:entity :eid] [:yaw :f32] [:pitch :f32]], :doc \"Write the controller pose absolutely.\"}}, :notes [\"The controller pose the ECS has never had: get-r* return constants today and\" \"set-rotation is a no-op, so nothing in the contract can express which way an\" \"actor is looking.\" \"\" \"move() is the important one. It takes stick input in CAMERA space and\" \"resolves it against the entity's own yaw, so forward means away from the\" \"camera. Feeding world axes into set-velocity instead — which is what the\" \"shipped royale does — is what makes a 3D game play like a map cursor.\"]}, :zone {:doc \"shrinking safe circle (battle-royale storm) as read-only state\", :funcs {:center-x {:params [], :ret :f32, :doc \"Safe-circle centre X (f32 bits).\"}, :center-z {:params [], :ret :f32, :doc \"Safe-circle centre Z (f32 bits).\"}, :radius {:params [], :ret :f32, :doc \"Safe-circle radius (f32 bits).\"}, :phase {:params [], :ret :i32, :doc \"Current storm phase index.\"}, :damage-per-second {:params [], :ret :f32, :doc \"Damage per second taken outside the circle (f32 bits).\"}, :inside {:params [[:entity :eid]], :ret :i32, :doc \"1 when the entity is within the circle, ground-plane only.\"}, :distance-outside {:params [[:entity :eid]], :ret :f32, :doc \"How far outside the circle the entity is; 0 when safe.\"}, :warning-level {:params [[:entity :eid]], :ret :i32, :doc \"0 safe, 1 within the scene's storm margin of the edge, 2 outside the circle.\"}}, :notes [\"Read-only. The circle is a pure function of match time (battle_royale_storm.edn),\" \"so it is identical on every client without being replicated and a replay lands\" \"on the same circle. Distances are ground-plane: jumping does not save you.\"]}, :weapon {:doc \"weapon state machine over the shared weapon table\", :funcs {:equip {:params [[:entity :eid] [:index :i32]], :doc \"Hold weapon `index`, fill the magazine, cancel any reload in flight.\"}, :equipped {:params [[:entity :eid]], :ret :i32, :doc \"Index of the held weapon, or -1 when unarmed.\"}, :can-fire {:params [[:entity :eid]], :ret :i32, :doc \"1 when alive, armed, loaded, not reloading and past the fire-rate interval.\"}, :fire {:params [[:entity :eid]], :ret :eid, :doc \"Pull the trigger; returns the entity hit, or -1.\"}, :reload {:params [[:entity :eid]], :doc \"Begin a reload, if one is warranted.\"}, :ammo {:params [[:entity :eid]], :ret :i32, :doc \"Rounds in the magazine.\"}, :reserve-ammo {:params [[:entity :eid]], :ret :i32, :doc \"Rounds in the backpack.\"}, :reloading {:params [[:entity :eid]], :ret :i32, :doc \"1 while a reload is in flight.\"}}, :notes [\"Backed by the shared 25-row weapon table (battle_royale_weapons.edn).\" \"fire() returns the entity hit, or -1 for a miss, a refused trigger pull or a\" \"projectile still in flight — the caller distinguishes those with can-fire and\" \"the event stream rather than by guessing from the -1.\"]}, :perception {:doc \"what an observer is allowed to know: range, cone, occlusion, memory\", :funcs {:can-see {:params [[:observer :eid] [:target :eid]], :ret :i32, :doc \"1 when the target is in range, inside the view cone and unoccluded.\"}, :can-hear {:params [[:observer :eid] [:target :eid] [:loud :i32]], :ret :i32, :doc \"1 when the target is within hearing range; `loud` widens it to gunshot range.\"}, :sense-nearest {:params [[:observer :eid] [:tag :str]], :ret :eid, :doc \"Nearest perceived entity with `tag`, or -1. Never returns a teammate.\"}, :remember {:params [[:observer :eid] [:target :eid]], :doc \"Record a contact so it survives a brief loss of line of sight.\"}, :remembered {:params [[:observer :eid]], :ret :eid, :doc \"The remembered contact, or -1 once memory has lapsed.\"}}, :notes [\"A filter, not a behaviour. The shipped bot calls nearest-tagged with a 3000\" \"unit range, so every bot knows where the player is, through walls, always.\" \"These honour range, view cone and occlusion, and remember a contact briefly\" \"after it breaks line of sight.\"]}, :time {:doc \"game clock\", :funcs {:delta-ms {:params [], :ret :i64, :doc \"Milliseconds elapsed this frame.\"}, :elapsed-ms {:params [], :ret :i64, :doc \"Total milliseconds since engine start (monotonic).\"}, :tick {:params [], :ret :i64, :doc \"Tick number (fixed-timestep tick counter).\"}}}, :physics {:doc \"impulse / force application and raycast\", :funcs {:apply-impulse {:params [[:entity :eid] [:ix :f32] [:iy :f32] [:iz :f32]], :doc \"Instantaneous change of momentum (f32 bits).\"}, :apply-force {:params [[:entity :eid] [:fx :f32] [:fy :f32] [:fz :f32]], :doc \"Continuous force for this tick (f32 bits).\"}, :raycast {:params [[:ox :f32] [:oy :f32] [:oz :f32] [:dx :f32] [:dy :f32] [:dz :f32]], :ret :eid, :doc \"Cast a ray; returns the entity hit, or -1 on a miss. Origin + direction as f32 bit-patterns.\"}}}, :render {:doc \"draw calls issued from script (the real renderer is wgpu)\", :funcs {:draw-mesh {:params [[:mesh :str] [:x :f32] [:y :f32] [:z :f32]], :doc \"Queue a mesh draw at position (f32 bits). mesh-name must be registered.\"}, :spawn-particle {:params [[:preset :str] [:x :f32] [:y :f32] [:z :f32]], :doc \"Emit a billboard particle burst.\"}, :draw-line {:params [[:x0 :f32] [:y0 :f32] [:z0 :f32] [:x1 :f32] [:y1 :f32] [:z1 :f32] [:color :i32]], :doc \"Debug line (start / end as f32 bits, colour as 0xRRGGBBAA).\"}, :rt-enable {:params [[:recipe :str]], :doc \"Switch the frame to a named ray-tracing recipe (kami.rt IR); empty name disables RT and falls back to the raster path.\"}}}, :random {:doc \"host-owned seeded PRNG (shared-seed determinism for online/replay)\", :funcs {:int {:params [[:n :i64]], :ret :i64, :doc \"Uniform integer in [0, n).\"}}, :notes [\"The host owns the seed so online co-op stays deterministic (shared-seed):\" \"the same seed + same inputs replay identically, which also backs async\" \"race / ghost / anti-cheat. The guest never holds or advances the seed.\"]}, :audio {:doc \"fire-and-forget sound triggers + binaural listener pose\", :funcs {:play {:params [[:name :str]], :doc \"Start a named sound.\"}, :stop {:params [[:name :str]], :doc \"Stop a named sound.\"}, :play-at {:params [[:name :str] [:x :f32] [:y :f32] [:z :f32]], :doc \"Spatial: play sound at world position.\"}, :set-listener {:params [[:x :f32] [:y :f32] [:z :f32] [:fx :f32] [:fy :f32] [:fz :f32]], :doc \"Binaural: set listener position (x,y,z) + forward (fx,fy,fz) as f32 bits.\"}}}, :input {:doc \"discrete and analog input queries\", :funcs {:key-down {:params [[:key :str]], :ret :i32, :doc \"Returns 1 if the named key is currently held, 0 otherwise.\"}, :key-pressed {:params [[:key :str]], :ret :i32, :doc \"Returns 1 on the first frame the key was pressed (edge detect).\"}, :axis {:params [[:name :str]], :ret :f32, :doc \"Returns f32 bit-pattern of an analog axis in [-1, 1].\"}, :pointer-x {:params [], :ret :f32, :doc \"Mouse / touch screen position X in canvas pixels (f32 bits).\"}, :pointer-y {:params [], :ret :f32, :doc \"Mouse / touch screen position Y in canvas pixels (f32 bits).\"}}}, :attributes {:doc \"named f32 attribute plane per entity (health, team, ammo, facing, …)\", :funcs {:get-attr {:params [[:entity :eid] [:name :str]], :ret :f32, :doc \"Read a named attribute, or its registered default.\"}, :set-attr {:params [[:entity :eid] [:name :str] [:value :f32]], :doc \"Write a named attribute, clamped to its registered range.\"}, :add-attr {:params [[:entity :eid] [:name :str] [:delta :f32]], :ret :f32, :doc \"Read-modify-write through the clamp; returns the new value.\"}}, :notes [\"The shipped ECS entity is a tag, a position and a velocity. Nothing else can\" \"be said about it, which is why a guest written against this contract can only\" \"move point masses around a plane.\" \"\" \"This is one typed channel for everything else — health, shield, team, facing,\" \"ammo, stance, AI state. Adding a mechanic costs a row in the attribute\" \"registry rather than a new host import. Unregistered names are legal scratch\" \"space and default to 0; registered ones carry a default and a clamp, so a\" \"read before any write returns full health rather than nil, and no writer can\" \"put an attribute out of range.\"]}, :combat {:doc \"one damage pipeline: shields, armour, teams, kill credit\", :funcs {:apply-damage {:params [[:instigator :eid] [:target :eid] [:amount :f32] [:zone :i32]], :ret :f32, :doc \"Apply damage through the shared pipeline; returns the amount absorbed.\"}, :heal {:params [[:target :eid] [:amount :f32]], :ret :f32, :doc \"Restore health up to the entity's maximum; returns the amount gained.\"}, :add-shield {:params [[:target :eid] [:amount :f32]], :ret :f32, :doc \"Add shield up to the entity's maximum; returns the amount gained.\"}, :alive {:params [[:entity :eid]], :ret :i32, :doc \"1 when the entity is registered, flagged alive and above 0 health.\"}, :same-team {:params [[:a :eid] [:b :eid]], :ret :i32, :doc \"1 when the two entities are protected from each other (team 0 never is).\"}}, :notes [\"Every health change goes through apply-damage. Once damage can be applied\" \"from more than one place, the rules — team protection, armour, shield order,\" \"kill credit — start to disagree between the places.\" \"zone: 0 body, 1 head. Returns the damage actually absorbed, which is what a\" \"hit marker and the damage-dealt statistic should both read.\"]}, :match {:doc \"GameMode / GameState: entrants, survivors, placements\", :funcs {:alive-count {:params [], :ret :i64, :doc \"Entrants still alive.\"}, :entrants {:params [], :ret :i64, :doc \"Entrant count fixed at match start.\"}, :state {:params [], :ret :i32, :doc \"0 pending, 1 live, 2 ended.\"}, :place {:params [[:entity :eid]], :ret :i32, :doc \"Final placement, or 0 while still alive.\"}, :winner {:params [], :ret :eid, :doc \"The last survivor, or -1.\"}}, :notes [\"state: 0 pending, 1 live, 2 ended. place() is 0 until the entity is out.\" \"Placements count down from the entrant count, so the last survivor is 1.\"]}, :scene {:doc \"ECS entity lifecycle and transform queries\", :funcs {:nearest {:params [[:tag :str] [:x :f32] [:y :f32] [:maxd :f32]], :ret :eid, :doc \"Nearest entity tagged `tag` within `maxd` of (x,y) [f32 bits]; -1 if none.\"}, :despawn {:params [[:entity :eid]], :doc \"Remove an entity.\"}, :spawn {:params [[:kind :str]], :ret :eid, :doc \"Spawn a named entity type; returns a stable entity handle.\"}, :get-x {:params [[:entity :eid]], :ret :f32, :doc \"Read translation X — IEEE-754 f32 bit-pattern as i32.\"}, :set-position {:params [[:entity :eid] [:x :f32] [:y :f32] [:z :f32]], :doc \"Write all three translation components atomically.\"}, :get-rz {:params [[:entity :eid]], :ret :f32, :doc \"Rotation quaternion Z.\"}, :get-rw {:params [[:entity :eid]], :ret :f32, :doc \"Rotation quaternion W.\"}, :get-z {:params [[:entity :eid]], :ret :f32, :doc \"Read translation Z.\"}, :get-vx {:params [[:entity :eid]], :ret :f32, :doc \"Velocity X.\"}, :query-begin {:params [[:tag :str]], :ret :eid, :doc \"Snapshot the entities tagged `tag`; returns an opaque cursor handle.\"}, :get-vz {:params [[:entity :eid]], :ret :f32, :doc \"Velocity Z.\"}, :set-rotation {:params [[:entity :eid] [:rx :f32] [:ry :f32] [:rz :f32] [:rw :f32]], :doc \"Write the rotation quaternion.\"}, :get-y {:params [[:entity :eid]], :ret :f32, :doc \"Read translation Y.\"}, :get-vy {:params [[:entity :eid]], :ret :f32, :doc \"Velocity Y.\"}, :get-ry {:params [[:entity :eid]], :ret :f32, :doc \"Rotation quaternion Y.\"}, :move-toward {:params [[:entity :eid] [:target :eid] [:speed :f32]], :doc \"Set entity velocity toward `target` at `speed` px/s [f32 bits]. Host does the normalize x speed vector math so scripts need no in-guest f32 arithmetic.\"}, :query-next {:params [[:it :eid]], :ret :eid, :doc \"Advance the cursor; returns the next entity id, or -1 when drained.\"}, :count-tagged {:params [[:tag :str]], :ret :i64, :doc \"Count entities tagged `tag`.\"}, :spawn-ring {:params [[:kind :str] [:radius :f32] [:index :i32] [:of :i32]], :ret :eid, :doc \"Spawn `kind` at the `index`-th of `of` evenly spaced points on a ring of `radius`. The guest has no sin/cos, so a ring spawn is otherwise unexpressible and games hardcode a handful of points instead.\"}, :get-rx {:params [[:entity :eid]], :ret :f32, :doc \"Rotation quaternion X (unit quaternion, f32 bit-patterns).\"}, :set-velocity {:params [[:entity :eid] [:vx :f32] [:vy :f32] [:vz :f32]], :doc \"Write velocity.\"}}, :notes [\"All positions/velocities are f32 bit-patterns passed as i32.\" \"Entity IDs are i64 (hecs Entity bits). A return of -1 means \\\"not found\\\".\"]}}", :wit.kami-interface/exports "{:cabi_realloc {:params [[:old-ptr :i32] [:old-size :i32] [:align :i32] [:new-size :i32]], :ret :i32}, :init {:params []}, :tick {:params [[:dt-ms :i64]]}, :on-event {:params [[:kind :i32] [:payload :str]], :ret :i32}}"}]
