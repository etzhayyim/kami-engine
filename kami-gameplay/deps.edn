;; kami-gameplay — portable gameplay framework for the KAMI engine.
;;
;; No external dependencies on purpose. Every namespace here is pure `.cljc`
;; over plain maps and vectors, which is what lets the same code run as the
;; browser host's authority, as a native host's authority, and as the parity
;; oracle the Rust `battle_royale.rs` used to be before it left this repository.
;;
;; Two ways to run the suite, both of which must pass:
;;   clojure -M:test              JVM
;;   npx --yes nbb bin/run_tests.cljs   Node / ClojureScript
;; The second is not a convenience: cross-platform bit-identical arithmetic is a
;; load-bearing property here (see kami.gameplay.rng), and a suite that only ran
;; on one platform could not observe it.
{:paths ["src" "resources"]
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
